auto-install-peers=false
strict-peer-dependencies=false

# CI (Cloudflare Workers Builds) يشغّل pnpm install بوضع frozen افتراضياً،
# فيفشل التركيب بـ ERR_PNPM_LOCKFILE_CONFIG_MISMATCH عند أي فرق بين إعدادات
# pnpm-workspace.yaml وما هو مسجّل داخل pnpm-lock.yaml — وهو ما كان يوقف البناء
# حتى للتعديلات التي لا تمس الحزم إطلاقاً.
# الحل في المستودع بدل الاعتماد على راية في أمر البناء داخل لوحة Cloudflare.
frozen-lockfile=false
